@startuml ge-exemplo
' Exemplo pequeno de G_E: duas linhas, uma baldeação em B e uma caminhada C <-> D.
' Usado na seção Modelagem do relatório (relatorio/secoes/modelagem.tex).
' Duas fileiras: paradas em cima, plataformas embaixo.
!pragma layout smetana
skinparam dpi 200
skinparam defaultFontSize 13
skinparam shadowing false
skinparam rectangleRoundCorner 12
skinparam ArrowFontSize 12
hide stereotype

skinparam rectangle<<parada>> {
  BackgroundColor #FFFFFF
  BorderColor #333333
}
skinparam rectangle<<plataforma>> {
  BackgroundColor #E8EEF7
  BorderColor #4A6FA5
}

rectangle "A" as A <<parada>>
rectangle "B" as B <<parada>>
rectangle "C" as C <<parada>>
rectangle "D" as D <<parada>>
rectangle "A·L1" as A1 <<plataforma>>
rectangle "B·L1" as B1 <<plataforma>>
rectangle "B·L2" as B2 <<plataforma>>
rectangle "C·L2" as C2 <<plataforma>>

A -down-> A1 : embarque\nH₁/2
A1 -right-> B1 : viagem L1\nt(A,B)
B1 -up-> B : desembarque\n0
B -down-> B2 : embarque\nH₂/2
B2 -right-> C2 : viagem L2\nt(B,C)
C2 -up-> C : desembarque\n0
C -right-> D : caminhada\nd/v
D -left-> C : caminhada\nd/v
@enduml
